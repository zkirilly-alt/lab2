	cd /home/zx/Documents/progi/lab2/build && $(MAKE) $(MAKESILENT) -f src/CMakeFiles/lab2_gtk.dir/build.make src/CMakeFiles/lab2_gtk.dir/main_gtk.cpp.o
.PHONY : main_gtk.cpp.o

main_gtk.i: main_gtk.cpp.i
.PHONY : main_gtk.i


main_gtk.cpp.i:
	cd /home/zx/Documents/progi/lab2/build && $(MAKE) $(MAKESILENT) -f src/CMakeFiles/lab2_gtk.dir/build.make src/CMakeFiles/lab2_gtk.dir/main_gtk.cpp.i
.PHONY : main_gtk.cpp.i

main_gtk.s: main_gtk.cpp.s
.PHONY : main_gtk.s


main_gtk.cpp.s:
	cd /home/zx/Documents/progi/lab2/build && $(MAKE) $(MAKESILENT) -f src/CMakeFiles/lab2_gtk.dir/build.make src/CMakeFiles/lab2_gtk.dir/main_gtk.cpp.s
.PHONY : main_gtk.cpp.s












cmake_check_build_system:
	cd /home/zx/Documents/progi/lab2/build && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

